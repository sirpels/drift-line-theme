<section
  class="hero"
  {% if section.settings.heading != blank %}
    aria-labelledby="HeroHeading-{{ section.id }}"
  {% else %}
    aria-label="{{ section.settings.kicker | default: shop.name | escape }}"
  {% endif %}
>
  <div class="hero__inner">
    <div class="hero__content">
      {% if section.settings.kicker != blank %}
        <p class="hero__kicker">{{ section.settings.kicker | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="hero__heading" id="HeroHeading-{{ section.id }}">
          {{ section.settings.heading | escape }}
        </h1>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="hero__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

      <div class="hero__actions">
        {% if section.settings.primary_label != blank %}
          <a
            class="hero__button hero__button--primary"
            href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}"
          >
            {{ section.settings.primary_label | escape }}
          </a>
        {% endif %}

        {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
          <a class="hero__button hero__button--secondary" href="{{ section.settings.secondary_link }}">
            {{ section.settings.secondary_label | escape }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="hero__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            widths: '480, 720, 960, 1200, 1600',
            sizes: '(min-width: 990px) 46vw, 100vw',
            class: 'hero__image',
            loading: 'eager',
            alt: section.settings.image_alt
        }}
      {% else %}
        <div class="hero__media-placeholder" aria-hidden="true">
          <span>Go Crazy</span>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Lagos streetwear"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Go Crazy. Dress like the city is watching."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Supporting text",
      "default": "<p>Premium Nigerian streetwear built for late nights, clean lines, and everyday movement.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop new arrivals"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Explore the brand"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Go Crazy streetwear look"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
